import tkinter as tk
from tkinter import messagebox
import math

# ==========================================
# CLASE DEL MODELO (Lógica de las Notas)
# ==========================================
class Notas:
    def __init__(self):
        # En Python usamos una lista en lugar de un array fijo
        self.lista_notas = [0.0] * 5

    def calcular_promedio(self):
        suma = sum(self.lista_notas)
        return suma / len(self.lista_notas)

    def calcular_desviacion(self):
        promedio = self.calcular_promedio()
        suma_cuadrados = sum(math.pow(nota - promedio, 2) for nota in self.lista_notas)
        return math.sqrt(suma_cuadrados / len(self.lista_notas))

    def calcular_mayor(self):
        return max(self.lista_notas)

    def calcular_menor(self):
        return min(self.lista_notas)

# ==========================================
# CLASE DE LA INTERFAZ (Ventana Principal)
# ==========================================
class VentanaPrincipal(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Notas del Estudiante")
        # Manteniendo exactamente las mismas dimensiones que tu Java
        self.geometry("420x410")
        self.resizable(False, False)

        # Equivalente a setLayout(null), usando el método place() con coordenadas

        # Nota 1
        tk.Label(self, text="Nota 1:").place(x=20, y=20, width=80, height=25)
        self.campo_nota1 = tk.Entry(self)
        self.campo_nota1.place(x=110, y=20, width=150, height=25)

        # Nota 2
        tk.Label(self, text="Nota 2:").place(x=20, y=55, width=80, height=25)
        self.campo_nota2 = tk.Entry(self)
        self.campo_nota2.place(x=110, y=55, width=150, height=25)

        # Nota 3
        tk.Label(self, text="Nota 3:").place(x=20, y=90, width=80, height=25)
        self.campo_nota3 = tk.Entry(self)
        self.campo_nota3.place(x=110, y=90, width=150, height=25)

        # Nota 4
        tk.Label(self, text="Nota 4:").place(x=20, y=125, width=80, height=25)
        self.campo_nota4 = tk.Entry(self)
        self.campo_nota4.place(x=110, y=125, width=150, height=25)

        # Nota 5
        tk.Label(self, text="Nota 5:").place(x=20, y=160, width=80, height=25)
        self.campo_nota5 = tk.Entry(self)
        self.campo_nota5.place(x=110, y=160, width=150, height=25)

        # Botones
        self.btn_calcular = tk.Button(self, text="Calcular", command=self.calcular)
        self.btn_calcular.place(x=100, y=205, width=110, height=30)

        self.btn_limpiar = tk.Button(self, text="Limpiar", command=self.limpiar)
        self.btn_limpiar.place(x=220, y=205, width=110, height=30)

        # Etiquetas de Resultados (anchor="w" es para alinearlas a la izquierda)
        self.lbl_promedio = tk.Label(self, text="Promedio = ", anchor="w")
        self.lbl_promedio.place(x=20, y=250, width=370, height=20)

        self.lbl_desviacion = tk.Label(self, text="Desviacion estandar = ", anchor="w")
        self.lbl_desviacion.place(x=20, y=275, width=370, height=20)

        self.lbl_mayor = tk.Label(self, text="Valor mayor = ", anchor="w")
        self.lbl_mayor.place(x=20, y=300, width=370, height=20)

        self.lbl_menor = tk.Label(self, text="Valor menor = ", anchor="w")
        self.lbl_menor.place(x=20, y=325, width=370, height=20)

    # Equivalente a tu método actionPerformed (botón calcular)
    def calcular(self):
        try:
            notas = Notas()
            # Capturamos los textos, los convertimos a decimales (float) y los guardamos
            notas.lista_notas[0] = float(self.campo_nota1.get())
            notas.lista_notas[1] = float(self.campo_nota2.get())
            notas.lista_notas[2] = float(self.campo_nota3.get())
            notas.lista_notas[3] = float(self.campo_nota4.get())
            notas.lista_notas[4] = float(self.campo_nota5.get())

            # Actualizamos los textos usando format para limitar a 2 decimales
            self.lbl_promedio.config(text=f"Promedio = {notas.calcular_promedio():.2f}")
            self.lbl_desviacion.config(text=f"Desviacion estandar = {notas.calcular_desviacion():.2f}")
            self.lbl_mayor.config(text=f"Valor mayor = {notas.calcular_mayor()}")
            self.lbl_menor.config(text=f"Valor menor = {notas.calcular_menor()}")
            
        except ValueError:
            # Si el usuario escribe letras o deja vacío, mostramos error
            messagebox.showerror("Error", "Por favor, ingrese valores numéricos válidos en todas las notas.")

    # Equivalente a tu método actionPerformed (botón limpiar)
    def limpiar(self):
        self.campo_nota1.delete(0, tk.END)
        self.campo_nota2.delete(0, tk.END)
        self.campo_nota3.delete(0, tk.END)
        self.campo_nota4.delete(0, tk.END)
        self.campo_nota5.delete(0, tk.END)
        
        self.lbl_promedio.config(text="Promedio = ")
        self.lbl_desviacion.config(text="Desviacion estandar = ")
        self.lbl_mayor.config(text="Valor mayor = ")
        self.lbl_menor.config(text="Valor menor = ")

# Equivalente al public static void main de Java
if __name__ == "__main__":
    mi_ventana_principal = VentanaPrincipal()
    mi_ventana_principal.mainloop()
