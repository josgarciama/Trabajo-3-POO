import tkinter as tk
from tkinter import messagebox
import math

# ==========================================
# MODELO LÓGICO (Jerarquía de Clases)
# ==========================================

class FiguraGeometrica:
    def __init__(self):
        self._volumen = 0.0
        self._superficie = 0.0

    def set_volumen(self, volumen):
        self._volumen = volumen

    def set_superficie(self, superficie):
        self._superficie = superficie

    def get_volumen(self):
        return self._volumen

    def get_superficie(self):
        return self._superficie


class Cilindro(FiguraGeometrica):
    def __init__(self, radio, altura):
        super().__init__()
        self.radio = radio
        self.altura = altura
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return math.pi * self.altura * math.pow(self.radio, 2.0)

    def calcular_superficie(self):
        area_lado_a = 2.0 * math.pi * self.radio * self.altura
        area_lado_b = 2.0 * math.pi * math.pow(self.radio, 2.0)
        return area_lado_a + area_lado_b


class Esfera(FiguraGeometrica):
    def __init__(self, radio):
        super().__init__()
        self.radio = radio
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return (4.0 / 3.0) * math.pi * math.pow(self.radio, 3.0)

    def calcular_superficie(self):
        return 4.0 * math.pi * math.pow(self.radio, 2.0)


class Piramide(FiguraGeometrica):
    def __init__(self, base, altura, apotema):
        super().__init__()
        self.base = base
        self.altura = altura
        self.apotema = apotema
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return (math.pow(self.base, 2.0) * self.altura) / 3.0

    def calcular_superficie(self):
        area_base = math.pow(self.base, 2.0)
        area_lado = 2.0 * self.base * self.apotema
        return area_base + area_lado


# ==========================================
# INTERFACES GRÁFICAS (Tkinter)
# ==========================================

class VentanaCilindro(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Cilindro")
        self.geometry("280x210")
        self.resizable(False, False)

        # Campos
        tk.Label(self, text="Radio (cms):").place(x=20, y=20, width=80, height=23)
        self.campo_radio = tk.Entry(self)
        self.campo_radio.place(x=110, y=20, width=125, height=23)

        tk.Label(self, text="Altura (cms):").place(x=20, y=50, width=80, height=23)
        self.campo_altura = tk.Entry(self)
        self.campo_altura.place(x=110, y=50, width=125, height=23)

        # Botón
        btn_calcular = tk.Button(self, text="Calcular", command=self.calcular)
        btn_calcular.place(x=100, y=80, width=135, height=23)

        # Resultados
        self.lbl_volumen = tk.Label(self, text="Volumen (cm3):", anchor="w")
        self.lbl_volumen.place(x=20, y=110, width=230, height=23)

        self.lbl_superficie = tk.Label(self, text="Superficie (cm2):", anchor="w")
        self.lbl_superficie.place(x=20, y=140, width=230, height=23)

    def calcular(self):
        try:
            radio_val = float(self.campo_radio.get())
            altura_val = float(self.campo_altura.get())
            
            cilindro = Cilindro(radio_val, altura_val)
            
            self.lbl_volumen.config(text=f"Volumen (cm3): {cilindro.get_volumen():.2f}")
            self.lbl_superficie.config(text=f"Superficie (cm2): {cilindro.get_superficie():.2f}")
        except ValueError:
            messagebox.showerror("Error", "Campo nulo o error en formato de número", parent=self)


